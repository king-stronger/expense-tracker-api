DATABASE_URL=
# Optional dedicated DB for Vitest (falls back to DATABASE_URL)
DATABASE_URL_TEST=
# min 32 characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
# Frontend origin (CORS + Better Auth trusted origin)
BETTER_AUTH_TRUSTED_ORIGIN=http://localhost:5173
LOG_LEVEL=info
ENVIRONMENT=development
ENABLE_API_DOCS=true
# Optional override used by tests (default 20)
# AUTH_RATE_LIMIT_MAX=20
# Optional — without it, password-reset links are logged server-side
RESEND_API_KEY=
EMAIL_FROM=Expense Tracker <onboarding@resend.dev>
